# === 大文件：模型与数据集（不入库）===
# 获取方式见 AGENTS.md / models.yaml / datasets.yaml
models/
data/*
# 自建 codeswitch 语料（用户自制 TTS 合成，无版权问题）入库，只收 16k 评分版
!data/codeswitch/
data/codeswitch/wav/

# 结果中的音频落盘（TTS 样本等；JSON 结果保留入库以便复现与追溯）
# 站点音频已拍板全量入库：site/audio/ 不在此列（2026-10-10 用户确认）
results/**/*.wav
results/**/*.flac
results/**/*.mp3
results/**/*.ogg

# === Python ===
.venv*/
__pycache__/
*.py[cod]
*.egg-info/

# === 压缩包与工具 wheel（用户手动下载，不入库）===
*.tar.bz2
*.tar.gz
*.tgz
*.whl

# === agent 会话过程产物（本地状态，不入库）===
.agents/
.planning/

# === 系统/编辑器 ===
.DS_Store
*.swp
